<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ManiaMapAnalyzerOverlay.Avalonia.Views.AnalysisMappingHelpDialog"
        Width="760" Height="620" CanResize="True" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid RowDefinitions="Auto,*,Auto" Margin="22">
    <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" />
    <Border Grid.Row="1" Margin="0,16,0,0" BorderBrush="#2A2E3A" BorderThickness="1" CornerRadius="6" Padding="14">
      <ScrollViewer>
        <TextBlock x:Name="HelpText" TextWrapping="Wrap" FontSize="12" LineHeight="18" />
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
      <Button x:Name="CloseButton" Click="Close_Click" />
    </StackPanel>
  </Grid>
</Window>
