<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ManiaMapAnalyzerOverlay.Avalonia.ViewModels"
        x:Class="ManiaMapAnalyzerOverlay.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="860" Height="840" MinWidth="650" MinHeight="740"
        Background="#0E1016" Title="">
  <Grid x:Name="RootGrid" RowDefinitions="150,*">
    <Border x:Name="Toolbar" Background="#181B24" Padding="18,12,14,10">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="BrandText" FontSize="16" FontWeight="Bold" />
          <Button x:Name="SettingsButton" Grid.Column="1" Width="42" Height="36" Padding="0">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="260" Margin="8" Spacing="8">
                  <Button x:Name="ReplayButton" Click="Replay_Click" HorizontalContentAlignment="Left" />
                  <Button x:Name="MappingButton" Click="Mapping_Click" HorizontalContentAlignment="Left" />
                  <Button x:Name="HelpButton" Click="Help_Click" HorizontalContentAlignment="Left" />
                  <Button x:Name="FullscreenButton" Click="Fullscreen_Click" HorizontalContentAlignment="Left" />
                  <Button x:Name="DashboardButton" Click="Dashboard_Click" HorizontalContentAlignment="Left" />
                  <Grid ColumnDefinitions="*,130">
                    <TextBlock x:Name="LanguageMenuLabel" VerticalAlignment="Center" />
                    <ComboBox x:Name="LanguageSelector" Grid.Column="1" SelectionChanged="LanguageSelector_SelectionChanged" />
                  </Grid>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
            <TextBlock Text="⚙" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Button>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="2,9,0,0">
          <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#F5B342" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Status}" Foreground="#B2B8C7" VerticalAlignment="Center" />
        </StackPanel>
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
             <Button x:Name="AnalysisButton" Click="Analysis_Click" Margin="0,0,8,8" />
             <Button x:Name="AppearanceButton" Click="Appearance_Click" Margin="0,0,8,8" />
            <Button x:Name="PreviewScaleDownButton" Content="−" Click="PreviewScaleDown_Click" Margin="0,0,4,8" Padding="11,4" />
            <Button x:Name="PreviewScaleText" Content="100%" IsHitTestVisible="False" Margin="0,0,4,8" Padding="8,4" />
            <Button x:Name="PreviewScaleUpButton" Content="+" Click="PreviewScaleUp_Click" Margin="0,0,8,8" Padding="11,4" />
            <Button x:Name="OverlayButton" Click="Overlay_Click" Margin="0,0,8,8" Background="#335C7E" />
            <Button x:Name="RestartButton" Click="Restart_Click" Margin="0,0,8,8" />
            <Button x:Name="ExitButton" Click="Exit_Click" Margin="0,0,8,8" Background="#A2334B" />
        </WrapPanel>
      </Grid>
    </Border>
    <Border x:Name="BrowserHost" Grid.Row="1" Background="#0E1016" />
    <Border x:Name="HeadlessBrowserHost"
            Grid.Row="1"
            Width="1"
            Height="1"
            Margin="-2"
            Opacity="0"
            IsHitTestVisible="False"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />
  </Grid>
</Window>
