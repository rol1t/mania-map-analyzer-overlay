<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ManiaMapAnalyzerOverlay.Avalonia.Views.DocumentationDialog"
        Width="880" Height="640" CanResize="True" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid RowDefinitions="Auto,*" Margin="18">
    <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" />
    <Grid Grid.Row="1" ColumnDefinitions="200,*" Margin="0,16,0,0">
      <Border BorderBrush="#2A2E3A" BorderThickness="1" CornerRadius="6" Padding="8">
        <ListBox x:Name="NavList" SelectionChanged="NavList_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Border Grid.Column="1" Margin="12,0,0,0" BorderBrush="#2A2E3A" BorderThickness="1" CornerRadius="6" Padding="12">
        <ScrollViewer x:Name="ContentScroll" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ContentPanel" Spacing="8" />
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
