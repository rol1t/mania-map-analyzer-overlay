<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType Condition="'$(OS)' == 'Windows_NT'">WinExe</OutputType>
    <OutputType Condition="'$(OS)' != 'Windows_NT'">Exe</OutputType>
    <AssemblyName>Mania Map Analyzer Overlay</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ManiaMapAnalyzerOverlay.Avalonia.Tests" />
    <ProjectReference Include="..\Core\ManiaMapAnalyzerOverlay.Core.csproj" />
    <ProjectReference Include="..\RealtimeAnalysis\ManiaMapAnalyzerOverlay.RealtimeAnalysis.csproj" />
    <ProjectReference Include="..\ReplayAnalysis\ManiaMapAnalyzerOverlay.ReplayAnalysis.csproj" />
    <ProjectReference Include="..\Application\ManiaMapAnalyzerOverlay.Application.csproj" />
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <Compile Include="..\Services\OverlayStyleBuilder.cs" Link="Shared\OverlayStyleBuilder.cs" />
    <Compile Include="..\Services\UiText.cs" Link="Shared\UiText.cs" />
    <None Include="..\..\assets\overlay-custom.css" Link="Assets\overlay-custom.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="..\..\assets\overlay\**" LinkBase="Assets\overlay" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="..\..\assets\analyzers\**" LinkBase="Assets\analyzers" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="..\..\assets\analyzer-engines\**" LinkBase="Assets\analyzer-engines" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="..\..\assets\localization\**" LinkBase="Assets\localization" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />

    <EmbeddedResource Include="..\..\assets\overlay-custom.css"
                      LogicalName="ManiaMapAnalyzerOverlay.RuntimeAssets/Assets/overlay-custom.css" />
    <EmbeddedResource Include="..\..\assets\overlay\**"
                      LogicalName="ManiaMapAnalyzerOverlay.RuntimeAssets/Assets/overlay/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\analyzers\**"
                      LogicalName="ManiaMapAnalyzerOverlay.RuntimeAssets/Assets/analyzers/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\analyzer-engines\**"
                      LogicalName="ManiaMapAnalyzerOverlay.RuntimeAssets/Assets/analyzer-engines/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\localization\**"
                      LogicalName="ManiaMapAnalyzerOverlay.RuntimeAssets/Assets/localization/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\README.md"
                      LogicalName="ManiaMapAnalyzerOverlay.RuntimeAssets/README.md" />
    <EmbeddedResource Include="..\..\LICENSE"
                      LogicalName="ManiaMapAnalyzerOverlay.RuntimeAssets/LICENSE" />
    <EmbeddedResource Include="..\..\LICENSES\**"
                      LogicalName="ManiaMapAnalyzerOverlay.RuntimeAssets/LICENSES/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\docs\**"
                      LogicalName="ManiaMapAnalyzerOverlay.RuntimeAssets/docs/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(EmbeddedUpdaterPath)"
                      Condition="'$(EmbeddedUpdaterPath)' != '' and Exists('$(EmbeddedUpdaterPath)')"
                      LogicalName="ManiaMapAnalyzerOverlay.Tools/Updater" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="11.4.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
