<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType Condition="'$(OS)' == 'Windows_NT'">WinExe</OutputType>
    <OutputType Condition="'$(OS)' != 'Windows_NT'">Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>2.3.0</Version>
    <AssemblyVersion>2.3.0.0</AssemblyVersion>
    <FileVersion>2.3.0.0</FileVersion>
    <InformationalVersion>2.3.0</InformationalVersion>
    <AssemblyName>Mania Map Analyzer Overlay</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\ManiaMapAnalyzerOverlay.Core.csproj" />
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <Compile Include="..\Services\OverlayStyleBuilder.cs" Link="Shared\OverlayStyleBuilder.cs" />
    <Compile Include="..\Services\UiText.cs" Link="Shared\UiText.cs" />
    <None Include="..\..\assets\overlay-custom.css" Link="Assets\overlay-custom.css" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\overlay\**" LinkBase="Assets\overlay" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\assets\analyzers\**" LinkBase="Assets\analyzers" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\assets\analyzer-engines\**" LinkBase="Assets\analyzer-engines" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\assets\localization\**" LinkBase="Assets\localization" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="11.4.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
